# Harpoon Story Engine — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Who you are ───────────────────────────────────────────────────
# Shown to other editors when you both have the same story open.
EDITOR_NAME=Your Name

# ── Supabase (where stories are saved) ────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AWS S3 ────────────────────────────────────────────────────────
S3_BUCKET=harpoon-stories
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-west-2

# ── Delivery ──────────────────────────────────────────────────────
DELIVERY_DOMAIN=stories.har.pn

# ── GitHub ────────────────────────────────────────────────────────
# Used by the editor's Deploy button to start the publish workflow.
# Best: a fine-grained token for this one repository with
# "Actions: Read and write" (github.com → Settings → Developer settings →
# Personal access tokens → Fine-grained tokens). A classic token with
# 'repo' scope also works.
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=HarpoonProductions/harpoon-story-engine
