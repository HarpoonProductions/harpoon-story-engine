{
  "appId": "productions.harpoon.story-engine",
  "productName": "Story Engine",
  "copyright": "Copyright \u00a9 2026 Harpoon Productions Ltd",
  "directories": {
    "buildResources": "electron/build-assets",
    "output": "dist-electron"
  },
  "files": [
    "**/*",
    "!dist-electron/**",
    "!.git/**",
    "!.preview/**",
    "!projects/**",
    "!.env",
    "!.env.example",
    "!*.command",
    "!README-RACHEL.md",
    "!*.tar.gz",
    "!*.log",
    "!electron/build-assets/**"
  ],
  "extraResources": [
    {
      "from": "projects",
      "to": "projects",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "icon": "electron/build-assets/icon.png",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "hardenedRuntime": true,
    "entitlements": "electron/build-assets/entitlements.mac.plist",
    "entitlementsInherit": "electron/build-assets/entitlements.mac.plist"
  },
  "dmg": {
    "title": "Story Engine",
    "background": "electron/build-assets/dmg-background.png",
    "icon": "electron/build-assets/icon.png",
    "iconSize": 128,
    "contents": [
      {
        "x": 180,
        "y": 180,
        "type": "file"
      },
      {
        "x": 480,
        "y": 180,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 660,
      "height": 400
    }
  },
  "publish": {
    "provider": "github",
    "owner": "HarpoonProductions",
    "repo": "harpoon-story-engine"
  }
}